<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Memory: Krakarr is a long-running home-server app, so favour a small footprint over raw throughput.
    The Web SDK defaults to Server GC (one heap per core), which can hold hundreds of MB on many-core hosts.
    Workstation GC keeps a single heap; non-concurrent avoids the background GC thread and its extra reservations.
    The Docker image also sets DOTNET_gcServer=0, this covers bare-metal/`dotnet run` installs too.
  -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Krakarr.Core/Krakarr.Core.csproj" />
    <ProjectReference Include="../Krakarr.Data/Krakarr.Data.csproj" />
    <ProjectReference Include="../Krakarr.Data.Sqlite/Krakarr.Data.Sqlite.csproj" />
    <ProjectReference Include="../Krakarr.Data.Postgres/Krakarr.Data.Postgres.csproj" />
    <ProjectReference Include="../Krakarr.Media/Krakarr.Media.csproj" />
    <ProjectReference Include="../Krakarr.Indexers/Krakarr.Indexers.csproj" />
    <ProjectReference Include="../Krakarr.Downloads/Krakarr.Downloads.csproj" />
    <ProjectReference Include="../Krakarr.Movies/Krakarr.Movies.csproj" />
    <ProjectReference Include="../Krakarr.Series/Krakarr.Series.csproj" />
    <ProjectReference Include="../Krakarr.Subtitles/Krakarr.Subtitles.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>

  <!--
    Web UI: `dotnet build` / `dotnet run` / `dotnet publish` build the Angular app in ../../web into wwwroot.
    Requires Node.js 22+. Pass -p:SkipWebBuild=true to skip (Docker and CI build the UI separately).
  -->
  <PropertyGroup>
    <SkipWebBuild Condition="'$(SkipWebBuild)' == ''">false</SkipWebBuild>
    <WebUiDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../web/'))</WebUiDir>
    <WebUiOutput>$(MSBuildProjectDirectory)/wwwroot/</WebUiOutput>
  </PropertyGroup>

  <ItemGroup>
    <WebUiSource Include="$(WebUiDir)src/**/*;$(WebUiDir)public/**/*" />
    <WebUiSource Include="$(WebUiDir)angular.json;$(WebUiDir)package.json;$(WebUiDir)package-lock.json;$(WebUiDir)tsconfig*.json;$(WebUiDir).postcssrc.json" />
  </ItemGroup>

  <Target Name="EnsureNode" Condition="'$(SkipWebBuild)' != 'true'">
    <Exec Command="node --version" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
    </Exec>
    <Error Condition="'$(NodeExitCode)' != '0'"
           Text="Node.js 22+ is required to build the Krakarr web UI. Install it from https://nodejs.org, or build with -p:SkipWebBuild=true and run 'npm start' in the web folder." />
  </Target>

  <Target Name="NpmInstall" DependsOnTargets="EnsureNode"
          Condition="'$(SkipWebBuild)' != 'true' And !Exists('$(WebUiDir)node_modules')">
    <Message Importance="high" Text="Restoring web UI packages (npm ci)..." />
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(WebUiDir)" />
  </Target>

  <Target Name="BuildWebUi" BeforeTargets="Build" DependsOnTargets="EnsureNode;NpmInstall"
          Condition="'$(SkipWebBuild)' != 'true'"
          Inputs="@(WebUiSource)" Outputs="$(WebUiOutput)index.html">
    <Message Importance="high" Text="Building web UI (ng build)..." />
    <Exec Command="npx ng build" WorkingDirectory="$(WebUiDir)" EnvironmentVariables="NG_CLI_ANALYTICS=false" />
  </Target>

  <!-- wwwroot may be (re)generated after evaluation, so add its files to publish explicitly. -->
  <Target Name="IncludeWebUiInPublish" BeforeTargets="ComputeFilesToPublish" Condition="Exists('$(WebUiOutput)index.html')">
    <ItemGroup>
      <_WebUiFile Include="$(WebUiOutput)**/*" />
      <ResolvedFileToPublish Include="@(_WebUiFile->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(_WebUiFile.RecursiveDir)%(_WebUiFile.Filename)%(_WebUiFile.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
